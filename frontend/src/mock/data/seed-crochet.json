{
  "id": "seed-crochet",
  "title": "Crochet basics: hold and four first stitches",
  "skill": "crochet",
  "summary": "Hold the hook and yarn, then chain, slip stitch, single and double crochet, told apart by their yarn-over cycles. The gloves follow your hook hand's roll and your yarn finger's lift, so they count the yarn-over cycles; they cannot see the hook, the yarn or which stitch you went into.",
  "master_name": "Demo expert",
  "source": "seed",
  "created_at": "2026-11-14T00:00:00+00:00",
  "steps": [
    {
      "id": "seed-cr-hold",
      "title": "Lesson 1: Hook and yarn hold",
      "instruction": "Right hand: hold the hook like a pencil, thumb and index finger on the flat rest. Left hand: pinch the work between thumb and middle finger, yarn over the index finger.",
      "move_id": "cr_hold",
      "hands": "both",
      "prop": "none",
      "motion": {
        "preset": "hold_pose",
