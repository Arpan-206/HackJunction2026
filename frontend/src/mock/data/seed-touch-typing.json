{
  "id": "seed-touch-typing",
  "title": "Touch typing: the home row",
  "skill": "touch_typing",
  "summary": "Rest both hands on the home row, give every key its finger, reach the index fingers to G and H, then tap on an even beat. The gloves feel which finger strikes and when, not which key it lands on.",
  "master_name": "Demo expert",
  "source": "seed",
  "created_at": "2026-11-14T00:00:00+00:00",
  "steps": [
    {
      "id": "seed-ty-home-row",
      "title": "Lesson 1: Hands at rest on the home row",
      "instruction": "Curve both hands over the home row: left fingers on A S D F, right fingers on J K L and the semicolon, thumbs resting above the space bar. Wrists level, fingers soft, like holding a small ball in each hand.",
      "move_id": "ty_home_row",
      "hands": "both",
      "prop": "keyboard",
      "motion": {
        "preset": "hold_pose",
        "pose": {
          "thumb": 0.2,
          "index": 0.35,
