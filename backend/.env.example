# Copy to .env. Never commit real keys.
LLM_PROVIDER=fake            # fake | gemini | ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
GLOVE_SOURCE=simulator       # simulator | rokoko_udp | external | rokoko_sdk (stub)
ROKOKO_UDP_PORT=14043
DATA_DIR=./data
GEMINI_HINT_MODEL=gemini-3.5-flash-lite   # live coach hints use this model so they do not spend the main models 20 requests per day
# GEMINI_RPM_BUDGET=                      # override the per-minute request budget (default 80 percent of the free limit)
# GEMINI_RPD_BUDGET=                      # override the per-day request budget
# DEV_REVEAL=true                       # dev "Open file location" (POST /api/dev/reveal, GET /api/dev/locate), localhost only; false turns it off
