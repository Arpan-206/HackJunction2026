# Copy to .env. Never commit real keys.
LLM_PROVIDER=fake            # fake | gemini | openai (any OpenAI-compatible endpoint, e.g. Gemma on Verda)
LLM_FALLBACK=gemini,openai   # tried after the first provider fails (openai only when OPENAI_BASE_URL is set); none keeps one
LLM_ROUTES=                  # per-role first provider, e.g. lesson=openai,plan=openai sends those roles to Gemma on Verda first
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_BASE_URL=                        # Gemma on Verda (see verda/out/endpoint.json); empty keeps Verda out of every chain
OPENAI_API_KEY=
OPENAI_MODEL=google/gemma-4-31B-it
# Gemma on Verda, inference only (nothing is uploaded, nothing trains there; training is local). The Verda lane's own
# names; each one fills its OPENAI_ setting above when that is empty. Put real values only in .env, never here.
VERDA_GEMMA_URL=                        # base_url from verda/out/endpoint.json, e.g. https://<deployment>.<gateway host>
VERDA_INFERENCE_KEY=                    # the inference key from the Verda console
VERDA_GEMMA_MODEL=google/gemma-4-31B-it
COACH_MODEL=default                      # tuned: live hints try the fine-tuned small Gemma first (coach_tune/), then the chain
TUNED_BASE_URL=                          # the tuned coach's vLLM server (coach_tune/out/serve.json); empty keeps it off
TUNED_API_KEY=
TUNED_MODEL=geppetto-coach-e2b
TUNED_LANG=en                            # en, de or fi
GLOVE_SOURCE=simulator       # simulator | rokoko_udp | external | rokoko_sdk (stub)
ROKOKO_UDP_PORT=14043
DATA_DIR=./data
GEMINI_HINT_MODEL=gemini-3.5-flash-lite   # live coach hints use this model so they do not spend the main models 20 requests per day
# GEMINI_RPM_BUDGET=                      # override the per-minute request budget (default 80 percent of the free limit)
# GEMINI_RPD_BUDGET=                      # override the per-day request budget
# DEV_REVEAL=true                       # dev "Open file location" (POST /api/dev/reveal, GET /api/dev/locate), localhost only; false turns it off
# CORE_EXPORT=true                      # also write every take and lesson as a local core lesson folder (DATA_DIR/core_lessons) for Arpan's local tools
# CORE_EXPORT_DIR=                      # another folder for them
