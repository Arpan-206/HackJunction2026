# Copy to .env. Never commit real keys.
LLM_PROVIDER=fake            # fake | gemini | ollama | openai (any OpenAI-compatible endpoint, e.g. Gemma on Verda)
LLM_FALLBACK=ollama          # providers tried after LLM_PROVIDER fails, comma separated, then fake rule lines; none turns it off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OPENAI_BASE_URL=http://localhost:8000   # for LLM_PROVIDER=openai; the Verda endpoint is in verda/out/endpoint.json
OPENAI_API_KEY=
OPENAI_MODEL=google/gemma-4-31B-it
GLOVE_SOURCE=simulator       # simulator | rokoko_udp | external | rokoko_sdk (stub)
ROKOKO_UDP_PORT=14043
DATA_DIR=./data
GEMINI_HINT_MODEL=gemini-3.5-flash-lite   # live coach hints use this model so they do not spend the main models 20 requests per day
# GEMINI_RPM_BUDGET=                      # override the per-minute request budget (default 80 percent of the free limit)
# GEMINI_RPD_BUDGET=                      # override the per-day request budget
