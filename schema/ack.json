{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geppetto.local/schema/ack.json",
  "title": "ack: exactly one per command",
  "type": "object",
  "required": ["v", "type", "t", "id", "ok"],
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "ack" },
    "t": { "$ref": "common.json#/$defs/t_us" },
    "id": { "type": "string" },
    "ok": { "type": "boolean" },
    "result": { "type": "object" },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "enum": ["bad_args", "bad_state", "not_found", "busy", "device", "internal"] },
        "message": { "type": "string" }
      }
    }
  },
  "oneOf": [
    { "properties": { "ok": { "const": true } }, "required": ["result"] },
    { "properties": { "ok": { "const": false } }, "required": ["error"] }
  ]
}
